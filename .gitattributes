# Track large model files with Git LFS
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
# Track VLC binaries with Git LFS
vlc/**/*.dll filter=lfs diff=lfs merge=lfs -text
vlc/**/*.dylib filter=lfs diff=lfs merge=lfs -text
vlc/**/*.so filter=lfs diff=lfs merge=lfs -text
